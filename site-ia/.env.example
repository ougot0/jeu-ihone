# Copie ce fichier en ".env.local" puis remplis tes clés.
# ⚠️ Ne mets JAMAIS .env.local sur GitHub (il est déjà ignoré par git).

# Quel fournisseur d'IA utiliser : "gemini" ou "claude"
AI_PROVIDER=gemini

# --- Google Gemini (gratuit) : https://aistudio.google.com/apikey ---
GEMINI_API_KEY=colle-ta-cle-gemini-ici
# Modèle Gemini (facultatif)
GEMINI_MODEL=gemini-3.5-flash-lite

# --- Anthropic Claude (payant, peu cher) : https://console.anthropic.com ---
ANTHROPIC_API_KEY=
# Modèle Claude (facultatif)
CLAUDE_MODEL=claude-haiku-5-5

# --- Limite de messages par visiteur (facultatif) ---
RATE_LIMIT_MAX=20
RATE_LIMIT_WINDOW_MINUTES=10
